rules_version = '2';

// Production Firebase Storage Rules for SAI Happy Farms ERP
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default Deny: All paths are blocked by default unless explicitly permitted
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // SEC-25: authorization is resolved from the Firestore user profile (cross-service rules).
    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isAuthenticated() && userData().active == true;
    }

    function isAdmin() {
      return isActiveUser() && userData().role == 'admin';
    }

    function hasFarmAccess(farmId) {
      return isAdmin() || (isActiveUser() && farmId in userData().get('farmIds', []));
    }

    // Farm-scoped documents, receipts, and attachments
    // SEC-25: restricted to admins and active users assigned to this farm
    match /farms/{farmId}/{allPaths=**} {
      allow read: if hasFarmAccess(farmId);
      allow write: if hasFarmAccess(farmId) && request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }

    // User profile documents and personal receipts
    // Enforces user ownership isolation
    match /users/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }

    // System-generated exports (Excel, CSV, PDF reports)
    // SEC-25: not farm-scoped, so read is admin-only; writes restricted to backend service account
    match /exports/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
